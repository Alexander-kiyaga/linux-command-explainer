# ==============================================================================
# LinuxLab AI - Environment Configuration Template
# Copy this file to .env and fill in your Gemini API key:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API key (Required for AI explanations)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini model (Default: gemini-2.5-flash)
# Supported options include: gemini-2.5-flash, gemini-3.7-flash
GEMINI_MODEL=gemini-2.5-flash

# API timeout in seconds (1-60; converted to milliseconds for the SDK)
API_TIMEOUT_SECONDS=15

# Maximum allowed Explain command input length in characters (1-1000)
MAX_INPUT_LENGTH=500

# Maximum Explain response output tokens (128-8192)
MAX_OUTPUT_TOKENS=1500

# Separate Gemini response budgets for Task Builder and Bash Explain Script
# Each must be between 256 and 8192 tokens.
TASK_BUILDER_MAX_OUTPUT_TOKENS=3000
BASH_MAX_OUTPUT_TOKENS=4000

# Gemini-backed requests have a fixed 16 KiB Flask body cap. The production
# Nginx proxy also caps request bodies and applies per-IP and concurrency limits.

# Local server binding configuration (PORT: 1-65535)
PORT=5000
FLASK_DEBUG=False
