# ==============================================================================
# Linux Command Explainer - Environment Configuration Template
# Copy this file to .env and fill in your Gemini API key:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API key (Required for AI explanations)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini model (Default: gemini-2.5-flash)
# Supported options include: gemini-2.5-flash, gemini-3.7-flash
GEMINI_MODEL=gemini-2.5-flash

# API timeout in seconds (converted to milliseconds for the SDK)
API_TIMEOUT_SECONDS=15

# Maximum allowed command input length in characters (security defense)
MAX_INPUT_LENGTH=500

# Maximum response output tokens (configurable token limit)
MAX_OUTPUT_TOKENS=1500

# Local server binding configuration
PORT=5000
FLASK_DEBUG=False
